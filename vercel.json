{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "contadorakesiaaf.com.br" }],
      "destination": "https://www.contadorakesiaaf.com.br/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ]
}
